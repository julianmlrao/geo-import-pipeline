# Copy to .env and adjust. Never commit .env.
POSTGRES_DB=geo
POSTGRES_USER=geo_import
POSTGRES_PASSWORD=change-me
GEO_READER_PASSWORD=change-me-too
# 1 = run all sources once when the database is empty (first start)
GEO_IMPORT_RUN_ON_START=0

# --- only for the web demo (docker-compose.prod.yml) ---
SITE_ADDRESS=:80            # production: your domain, e.g. geo-demo.example.de
HTTP_PORT=8080              # production: 80
HTTPS_PORT=8443             # production: 443
ACME_EMAIL=
DEMO_USER=demo
DEMO_PASSWORD=
ADMIN_PASSWORD=
SESSION_SECRET=
GEO_IMPORT_TRIGGER_TOKEN=
COOKIE_SECURE=0             # production: 1
